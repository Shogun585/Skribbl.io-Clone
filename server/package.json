{
  "name": "skribblio-server",
  "version": "1.1.0",
  "description": "Authoritative OOP Node.js + Express 5 + Socket.IO 4.8 Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node ../scripts/sync-types.mjs",
    "dev": "tsx watch src/index.ts",
